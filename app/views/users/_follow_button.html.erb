<!-- app/views/users/_follow_button.html.erb -->
<% existing_request = FollowRequest.find_by(sender_id: current_user.id, recipient_id: other_user.id) %>

<% if existing_request.nil? %>
  <!-- No follow request sent => show 'Follow' -->
  <%= button_to "Follow", follow_requests_path, params: { follow_request: { recipient_id: other_user.id, status: "pending" } }, method: :post %>

<% elsif existing_request.status == "pending" %>
  <!-- Request is 'pending' => show 'Request sent' and 'Cancel' link -->
  Request sent
  <%= link_to "Cancel", follow_request_path(existing_request), method: :delete %>

<% elsif existing_request.status == "accepted" %>
  <!-- Already following => show 'Unfollow' -->
  <%= link_to "Unfollow", follow_request_path(existing_request), method: :delete %>

<% elsif existing_request.status == "rejected" %>
  <!-- If you want to re-request, show 'Follow' again or do nothing. -->
  (Rejected)
<% end %>
